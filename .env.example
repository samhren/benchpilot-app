# Local dev database (see docker-compose.yml). Safe to use as-is for local work.
DATABASE_URL=postgresql://benchpilot:benchpilot_dev@localhost:5433/benchpilot

# Deployed/production database. Used by `pnpm db:push:prod` /
# `db:generate:prod` / `db:studio:prod`. Leave unset locally unless you intend
# to operate on the deployed DB. NEVER commit a real value here.
PROD_DATABASE_URL=postgresql://user:password@host:port/database

# Accounts are now PIN-based (see docs/MULTI_USER_DEPLOY.md). APP_PASSWORD is
# no longer read by the running app — it is only the seed value for the legacy
# user's PIN, used by `db:seed` and `db:migrate-multi-user`.
APP_PASSWORD=changeme

# Signs session JWTs and peppers the PIN hashes. Use a random 32+ byte string.
# Keep stable: rotating it invalidates sessions and requires re-running the
# migration to re-hash PINs. Generate one with: openssl rand -base64 32
SESSION_SECRET=replace-with-a-random-32-byte-string

# Optional: enables AI Coach features. Get a key from Google AI Studio.
# GEMINI_MODEL overrides the default model if set.
GEMINI_API_KEY=
GEMINI_MODEL=
